# ---------------------------------------------------------------------------
# Wallforge — secrets and Firebase
#
# Client Firebase config (google-services.json / GoogleService-Info.plist) is
# not a server secret, but this project commits no credential material of any
# kind. See rules.md §14 (Security). Never merge exceptions for these paths.
# ---------------------------------------------------------------------------
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist

# Service accounts / private keys
*serviceAccount*.json
**/serviceAccount*.json
*.jks
*.keystore
key.properties
**/key.properties

# Local environment overrides
.env
.env.*
!.env.example
